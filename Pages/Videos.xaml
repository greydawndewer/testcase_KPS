<Page x:Class="kpsk.Pages.Videos"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Videos"
      Background="White">

    <Page.Resources>
        <!-- Search TextBox Style -->
        <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Black"/>
            <Setter Property="Foreground" Value="WhiteSmoke"/>
   
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Foreground="{TemplateBinding Foreground}"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Search Button Style -->
        <Style x:Key="SearchButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Black"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="20"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="contentPresenter"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#333333"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TransparentButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#33FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBlock" x:Key="TimeTextStyle">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="MinWidth" Value="40"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- CENTERED SEARCH BAR -->
        <StackPanel Grid.Row="0" Margin="0 0 0 20" 
                    HorizontalAlignment="Center" Orientation="Horizontal">
            <TextBox x:Name="SearchBox"
                     Width="400"  
                Height="35"
            
                Text="Type full video name..."
                     Style="{StaticResource SearchTextBoxStyle}"
                     VerticalAlignment="Center"
                     TextChanged="SearchBox_TextChanged"
                     GotFocus="SearchBox_GotFocus"
                     LostFocus="SearchBox_LostFocus"/>

                <Button Content="Search"
                    Width="80" 
                    Height="35"
               
                    Margin="15,0,0,0"
               
                    Style="{StaticResource SearchButtonStyle}"
                    Click="SearchButton_Click"/>
        </StackPanel>

        <Grid Grid.Row="1">
        
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="Gallery"
                      ItemsSource="{Binding FilteredVideos}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <!-- Increased video container size -->
                            <WrapPanel IsItemsHost="True" 
                                       ItemWidth="220" 
                                       ItemHeight="150"
                                       HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="Gray" BorderThickness="1"
          Margin="10"
          CornerRadius="8"
          MouseDown="Thumbnail_Click">
                                <Grid>
                                    <Image Source="{Binding Thumb}"
             Stretch="UniformToFill"/>

                                    <!-- Overlay at bottom with name and level -->
                                    <StackPanel VerticalAlignment="Bottom" Background="#80000000">
                                        <TextBlock Text="{Binding Name}"
                   Foreground="White"
                   Padding="6 4 6 2"
                   FontSize="14"
                   FontWeight="SemiBold"/>

                                        <TextBlock Text="{Binding Level}"
                   Foreground="White"
                   Background="Black"
                   Padding="6 2 6 4"
                   FontSize="12"
                   FontWeight="Bold"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Player Overlay -->
            <Grid x:Name="PlayerOverlay"
                  Background="Transparent"
                  Visibility="Collapsed">

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <!-- Video area -->
                    <RowDefinition Height="Auto"/>
                    <!-- Controls area -->
                </Grid.RowDefinitions>

                <!-- Video Player -->
                <MediaElement x:Name="Player"
                              Grid.Row="0"
                              Stretch="Uniform"
                              LoadedBehavior="Manual"
                              UnloadedBehavior="Stop"
                              MediaOpened="Player_MediaOpened"
                              MediaEnded="Player_MediaEnded"
                              MediaFailed="Player_MediaFailed"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Volume="0.5"/>

                <!-- Controls Panel -->
                <Border Grid.Row="1"
                        Background="#80000000"
                        CornerRadius="10"
                        Margin="20,10,20,20"
                        Padding="10,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Play/Pause -->
                        <Button Grid.Column="0" 
                                Width="36" Height="36" 
                                Click="PlayPause_Click"
                                Style="{StaticResource TransparentButton}">
                            <TextBlock x:Name="PlayPauseIcon" Text="▶" FontSize="18" Foreground="White"/>
                        </Button>

                        <!-- Current Time -->
                        <TextBlock x:Name="CurrentTimeText" Grid.Column="1" 
                                   Text="00:00" 
                                   Style="{StaticResource TimeTextStyle}"/>

                        <!-- Seek Bar -->
                        <Slider x:Name="SeekBar" Grid.Column="2" 
        VerticalAlignment="Center"
        Margin="5,0"
        Minimum="0"
        SmallChange="1"
        LargeChange="10"
        PreviewMouseDown="SeekBar_PreviewMouseDown"
        Thumb.DragStarted="SeekBar_DragStarted"
        Thumb.DragCompleted="SeekBar_DragCompleted"
        ValueChanged="SeekBar_ValueChanged"/>

                        <!-- Total Time -->
                        <TextBlock x:Name="TotalTimeText" Grid.Column="3" 
                                   Text="00:00" 
                                   Style="{StaticResource TimeTextStyle}"/>

                        <!-- Volume Control -->
                        <StackPanel Grid.Column="4" Orientation="Horizontal" 
                                    VerticalAlignment="Center" Margin="10,0,0,0">
                            <Button x:Name="VolumeButton" 
                                    Width="30" Height="30" 
                                    Click="VolumeButton_Click"
                                    Style="{StaticResource TransparentButton}">
                                <TextBlock x:Name="VolumeIcon" Text="🔊" FontSize="16"/>
                            </Button>
                            <Slider x:Name="VolumeSlider" 
                                    Width="80"
                                    Minimum="0" 
                                    Maximum="1" 
                                    Value="0.5"
                                    ValueChanged="VolumeSlider_ValueChanged"/>
                        </StackPanel>

                        <!-- Full Screen Toggle -->
                        <Button x:Name="FullScreenButton" Grid.Column="5" 
                                Width="36" Height="36" 
                                Click="FullScreenButton_Click"
                                Style="{StaticResource TransparentButton}">
                            <TextBlock x:Name="FullScreenIcon" Text="⛶" FontSize="18" Foreground="White"/>
                        </Button>

                        <!-- Close Player Button -->
                        <Button Grid.Column="6" 
                                Width="36" Height="36" 
                                Click="ClosePlayer_Click"
                                Style="{StaticResource TransparentButton}">
                            <TextBlock Text="✕" FontSize="18" Foreground="White"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
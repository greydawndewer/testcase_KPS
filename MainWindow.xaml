<Window x:Class="kpsk.MainWindow"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:local="clr-namespace:kpsk"
            mc:Ignorable="d"
            WindowState="Maximized"
            Title="Craftify" Height="720" Width="1280"
            WindowStartupLocation="CenterScreen"
            Background="White">

    <Window.Resources>
        <!-- Button Style with Hover Effect -->
        <Storyboard x:Key="HoverInAnimation">
            <ColorAnimation Storyboard.TargetProperty="(Button.Foreground).(SolidColorBrush.Color)"
                            To="#1E1E1E" Duration="0:0:0.2" />
            <ColorAnimation Storyboard.TargetProperty="(Button.Background).(SolidColorBrush.Color)"
                            To="White" Duration="0:0:0.2" />
        </Storyboard>
        <Storyboard x:Key="HoverOutAnimation">
            <ColorAnimation Storyboard.TargetProperty="(Button.Foreground).(SolidColorBrush.Color)"
                            To="White" Duration="0:0:0.2" />
            <ColorAnimation Storyboard.TargetProperty="(Button.Background).(SolidColorBrush.Color)"
                            To="Transparent" Duration="0:0:0.2" />
        </Storyboard>

        <!-- Button Style with Hover Effect -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard Storyboard="{StaticResource HoverInAnimation}"/>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard Storyboard="{StaticResource HoverOutAnimation}"/>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- App Name Button Style -->
        <Style x:Key="AppNameButtonStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,5"/>
        </Style>
        <Style x:Key="ProductImageContainerStyle" TargetType="Border">
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="CornerRadius" Value="8,8,0,0"/>
            <Setter Property="Height" Value="180"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ProductImageStyle" TargetType="Image">
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MaxHeight" Value="180"/>
            <Setter Property="MaxWidth" Value="280"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <!-- Product Card Style -->
        <Style x:Key="ProductCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Remove Button Style -->
        <Style x:Key="RemoveButton" TargetType="Button">
            <Setter Property="Background" Value="#F44336"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                    CornerRadius="4" 
                                    Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D32F2F"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0"
                Background="#1E1E1E"
                CornerRadius="0,20,20,0"
                Padding="20"
                SnapsToDevicePixels="True">
            <StackPanel VerticalAlignment="Stretch">
                <!-- App Name -->
                <Button Content="         Craftify         "
                        Style="{StaticResource AppNameButtonStyle}"
                        Click="Home_Click"/>

                <Separator Background="white" Height="2" Margin="0 12 0 10"/>

                <!-- Navigation Links -->
                <Button Content="Videos" Margin="0 5" Style="{StaticResource NavButtonStyle}" Click="Videos_Click"/>
                <Button Content="Marketplace" Margin="0 5" Style="{StaticResource NavButtonStyle}" Click="Marketplace_Click"/>
            </StackPanel>
        </Border>

        <!-- Main Area -->
        <Grid Grid.Column="1" Background="White">
            <Frame x:Name="MainFrame"
                       NavigationUIVisibility="Hidden"
                       Background="White"
                       Visibility="Collapsed"/>

            <!-- Bought Products Section (Visible by default) -->
            <ScrollViewer x:Name="BoughtProductsContainer" 
                              VerticalScrollBarVisibility="Auto"
                              Visibility="Visible">
                <StackPanel>
                    <!-- Header -->
                    <TextBlock Text="Products Bought"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Margin="20,10"
                                   Foreground="#333"/>

                    <!-- Products Grid -->
                    <ItemsControl x:Name="BoughtProductsList" Margin="20">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Changed card height to Auto to allow expansion -->
                                <Border Style="{StaticResource ProductCard}" Width="280" Margin="10" Height="Auto">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="140"/>
                                            <!-- Fixed image height -->
                                            <RowDefinition Height="*"/>
                                            <!-- Flexible details area -->
                                            <RowDefinition Height="Auto"/>
                                            <!-- Button row -->
                                        </Grid.RowDefinitions>

                                        <!-- Product Image -->
                                        <Border Grid.Row="0" Style="{StaticResource ProductImageContainerStyle}">
                                            <Image Source="{Binding Image}" 
                                           Style="{StaticResource ProductImageStyle}"
                                           />
                                        </Border>

                                        <!-- Product Details (now in ScrollViewer) -->
                                        <ScrollViewer Grid.Row="1" 
                              VerticalScrollBarVisibility="Auto"
                              Margin="15"
                              Padding="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" 
                                   FontSize="18" 
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,5"/>

                                                <TextBlock Text="{Binding Description}" 
                                   FontSize="14"
                                   Foreground="#666"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,5"/>

                                                <TextBlock Text="{Binding Price, StringFormat='Price: ${0}'}" 
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#4CAF50"/>
                                            </StackPanel>
                                        </ScrollViewer>

                                        <!-- Button fixed at bottom -->
                                        <Button Grid.Row="2" 
                        Content="Remove"
                        Style="{StaticResource RemoveButton}"
                        CommandParameter="{Binding Id}"
                        Click="RemoveButton_Click"
                        Margin="15,0,15,15"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>